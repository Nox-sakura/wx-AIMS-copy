/* custom-tab-bar/index.wxss */

.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: calc(100rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: #fff;
  border-top: 1rpx solid #E8ECF0;
  display: flex;
  align-items: flex-start;
  padding-top: 10rpx;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  position: relative;
  padding: 6rpx 0;
}

.tab-icon {
  font-size: 44rpx;
  line-height: 1;
  filter: grayscale(100%) opacity(0.5);
  transition: filter 0.2s;
}

.tab-label {
  font-size: 20rpx;
  color: #7F8C8D;
  transition: color 0.2s;
}

/* 选中状态 */
.tab-item.active .tab-icon {
  filter: none;
}

.tab-item.active .tab-label {
  color: #1A6EBD;
  font-weight: 600;
}

/* 未读角标 */
.badge {
  position: absolute;
  top: 0rpx;
  right: calc(50% - 46rpx);
  min-width: 32rpx;
  height: 32rpx;
  background: #E74C3C;
  color: #fff;
  font-size: 18rpx;
  font-weight: 700;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
  border: 2rpx solid #fff;
}

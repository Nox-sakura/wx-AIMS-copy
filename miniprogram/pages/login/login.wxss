/* pages/login/login.wxss */

.container {
  min-height: 100vh;
  background: var(--bg);
  display: flex;
  flex-direction: column;
}

/* 顶部蓝色 Header */
.header {
  background: linear-gradient(135deg, var(--primary-dark) 0%, var(--primary) 100%);
  padding: 80rpx 48rpx 100rpx;
  position: relative;
}

.logo-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.logo-icon {
  font-size: 80rpx;
  line-height: 1;
}

.app-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}

.hospital-name {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.75);
}

/* 表单卡片 */
.form-card {
  background: var(--card);
  border-radius: 24rpx 24rpx 0 0;
  margin-top: -40rpx;
  flex: 1;
  padding: 48rpx 40rpx;
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.08);
}

/* 步骤指示器 */
.steps {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 48rpx;
  gap: 0;
}

.step {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.step-dot {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  background: var(--border);
  color: var(--muted);
}

.step.active .step-dot {
  background: var(--primary);
  color: #fff;
}

.step.done .step-dot {
  background: var(--success);
  color: #fff;
}

.step-label {
  font-size: 22rpx;
  color: var(--muted);
}

.step.active .step-label {
  color: var(--primary);
  font-weight: 600;
}

.step-line {
  width: 80rpx;
  height: 2rpx;
  background: var(--border);
  margin: 0 12rpx;
  margin-bottom: 24rpx;
}

/* 表单字段 */
.step-content {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.field-group {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.field-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
}

.field-hint {
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.5;
}

.placeholder {
  color: #C0C8D0;
}

/* 验证码行 */
.sms-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.sms-input {
  flex: 1;
}

.btn-sms {
  flex-shrink: 0;
  width: 220rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: var(--primary);
  color: #fff;
  font-size: 26rpx;
  border-radius: 12rpx;
  border: none;
  padding: 0;
}

.btn-sms.disabled {
  background: #B0C4D8;
}

/* 返回行 */
.back-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
  padding: 8rpx 0;
}

.back-arrow {
  font-size: 32rpx;
  color: var(--primary);
}

.back-text {
  font-size: 26rpx;
  color: var(--primary);
}

/* Mock 测试提示（开发阶段） */
.mock-hint {
  background: #FFF8E1;
  border: 1rpx solid #FFE082;
  border-radius: 8rpx;
  padding: 16rpx 20rpx;
  font-size: 22rpx;
  color: #F57F17;
}

/* 错误提示 */
.error-bar {
  background: #FDECEA;
  border: 1rpx solid #FCCDD1;
  border-radius: 10rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  color: var(--danger);
  margin-top: 8rpx;
}

/* 底部声明 */
.footer-note {
  text-align: center;
  padding: 40rpx 48rpx;
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.8;
}

/* pages/profile/profile.wxss */

.page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 60rpx;
}

/* 用户卡片 */
.user-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 40rpx 40rpx 36rpx;
  background: var(--primary);
}

.user-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-text {
  font-size: 44rpx;
  color: #fff;
  font-weight: 700;
}

.user-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.user-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
}

.user-id {
  font-size: 22rpx;
  color: rgba(255,255,255,0.7);
}

.bind-tag {
  background: rgba(255,255,255,0.2);
  color: #fff;
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

/* 通用 section */
.section {
  margin-top: 16rpx;
  background: var(--card);
}

.section-header {
  padding: 28rpx 40rpx 16rpx;
  border-bottom: 1rpx solid var(--border);
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}

/* 提醒列表 */
.empty-tip {
  padding: 32rpx 40rpx;
  font-size: 26rpx;
  color: var(--muted);
}

.reminder-list {
  padding: 8rpx 0;
}

.reminder-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 20rpx 40rpx;
  border-bottom: 1rpx solid var(--border);
  position: relative;
}

.reminder-item:last-child {
  border-bottom: none;
}

.reminder-item.inactive {
  opacity: 0.5;
}

.reminder-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}

.type-medication { background: #F0F7FF; }
.type-followup   { background: #E8F8EF; }
.type-rest       { background: #FEF3E2; }

.reminder-content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.reminder-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}

.reminder-detail {
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.5;
}

.reminder-times {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
  margin-top: 6rpx;
}

.time-tag {
  background: var(--primary-light);
  color: var(--primary);
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
}

.expired-tag {
  position: absolute;
  right: 40rpx;
  top: 20rpx;
  font-size: 20rpx;
  background: var(--border);
  color: var(--muted);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

/* 功能菜单 */
.menu-list {
  padding: 0;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 40rpx;
  border-bottom: 1rpx solid var(--border);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.menu-icon {
  font-size: 34rpx;
}

.menu-label {
  font-size: 28rpx;
  color: var(--text);
}

.menu-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.menu-sub {
  font-size: 24rpx;
  color: var(--muted);
}

.menu-arrow {
  font-size: 36rpx;
  color: #C8D0D8;
}

/* 解绑区域 */
.unbind-wrap {
  margin-top: 40rpx;
  padding: 0 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.btn-unbind {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #FDEDEC;
  color: var(--danger);
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 16rpx;
  border: 2rpx solid #FADBD8;
}

.unbind-hint {
  font-size: 22rpx;
  color: var(--muted);
  text-align: center;
}

/* 版本号 */
.version-wrap {
  padding: 32rpx 40rpx;
  text-align: center;
}

.version-text {
  font-size: 20rpx;
  color: #B0BAC3;
  line-height: 1.6;
}

/* 访问记录弹窗 */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.45);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}

.modal-box {
  width: 100%;
  background: var(--card);
  border-radius: 24rpx 24rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
  max-height: 70vh;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 40rpx 24rpx;
  border-bottom: 1rpx solid var(--border);
  flex-shrink: 0;
}

.modal-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

.modal-close {
  font-size: 32rpx;
  color: var(--muted);
  padding: 8rpx;
}

.log-scroll {
  flex: 1;
  padding: 8rpx 0;
}

.log-empty {
  padding: 48rpx 40rpx;
  font-size: 26rpx;
  color: var(--muted);
  text-align: center;
}

.log-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 40rpx;
  border-bottom: 1rpx solid var(--border);
}

.log-item:last-child { border-bottom: none; }

.log-report {
  font-size: 26rpx;
  color: var(--text);
}

.log-time {
  font-size: 22rpx;
  color: var(--muted);
}

.modal-tip {
  padding: 20rpx 40rpx;
  font-size: 20rpx;
  color: var(--muted);
  text-align: center;
  border-top: 1rpx solid var(--border);
  flex-shrink: 0;
}

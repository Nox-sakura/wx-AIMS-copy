/* pages/reports/list.wxss */

.page {
  min-height: 100vh;
  background: var(--bg);
}

/* 顶部说明栏 */
.info-bar {
  padding: 20rpx 40rpx;
  background: var(--primary-light);
  border-bottom: 1rpx solid #AED6F1;
}

.info-text {
  font-size: 22rpx;
  color: var(--primary);
}

/* 报告列表 */
.report-list {
  padding: 24rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 报告卡片 */
.report-card {
  background: var(--card);
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.06);
  border: 2rpx solid transparent;
}

.report-card.unread {
  border-color: var(--primary);
  background: #F7FBFF;
}

/* 卡片头部 */
.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.card-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.card-date {
  font-size: 24rpx;
  color: var(--muted);
}

/* 状态标签 */
.status-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.status-tag.approved {
  background: #E8F8EF;
  color: #27AE60;
}

.status-tag.pending {
  background: #FEF0E7;
  color: #E67E22;
}

/* 卡片主体 */
.card-body {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.embryo-no {
  font-size: 24rpx;
  color: var(--muted);
}

.grade-desc {
  font-size: 26rpx;
  color: var(--text);
  line-height: 1.6;
}

/* 卡片底部 */
.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border);
}

.doctor-name {
  font-size: 24rpx;
  color: var(--muted);
}

.footer-right {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.unread-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--primary);
}

.view-detail {
  font-size: 26rpx;
  color: var(--primary);
  font-weight: 500;
}

/* 空/加载状态 */
.state-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
  gap: 16rpx;
}

.state-icon { font-size: 80rpx; }
.state-text { font-size: 28rpx; color: var(--muted); }
.state-sub  { font-size: 24rpx; color: #B0BAC3; }

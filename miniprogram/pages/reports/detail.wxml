<!-- pages/reports/detail.wxml -->
<view class="page">

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="state-center">
    <text class="state-text">加载中…</text>
  </view>

  <!-- 报告内容 -->
  <block wx:elif="{{report}}">

    <!-- ① Grade 核心展示区 -->
    <view class="grade-section">
      <view class="desensitized-tag">数据已脱敏</view>
      <grade-badge grade="{{report.grade}}" size="large" />
      <text class="grade-label">{{report.gradeLabel}}</text>
      <text class="grade-desc">{{report.gradeDesc}}</text>

      <view class="meta-row">
        <text class="meta-item">评估日期：{{report.assessDate}}</text>
        <text class="meta-item">胚胎编号：{{report.embryoNo}}</text>
        <text class="meta-item">负责医生：{{report.doctor}}</text>
      </view>
    </view>

    <!-- ② 关键指标区 -->
    <view class="section-card">
      <view class="section-title">
        <text class="section-icon">📊</text>
        <text>关键指标</text>
      </view>
      <view class="key-points-grid">
        <view
          wx:for="{{report.keyPoints}}"
          wx:key="label"
          class="key-point-item"
        >
          <text class="kp-label">{{item.label}}</text>
          <text class="kp-value">{{item.value}}</text>
        </view>
      </view>
    </view>

    <!-- ③ 概念指标区（论文 Table 1 概念，定性展示） -->
    <view class="section-card">
      <view class="section-title">
        <text class="section-icon">🔬</text>
        <text>形态学指标</text>
      </view>
      <view class="concept-tip">以下指标由 AI 辅助分析，仅供参考，最终以医生诊断为准</view>

      <!-- 正向指标 -->
      <view class="concept-group">
        <text class="concept-group-label">支持性特征</text>
        <view
          wx:for="{{positiveConcepts}}"
          wx:key="nameEn"
          class="concept-item pos"
        >
          <view class="concept-dot pos-dot"></view>
          <text class="concept-name">{{item.nameCn}}</text>
          <text class="concept-qual pos-qual">{{item.qualitative}}</text>
        </view>
      </view>

      <!-- 负向指标 -->
      <view class="concept-group">
        <text class="concept-group-label">风险特征</text>
        <view
          wx:for="{{negativeConcepts}}"
          wx:key="nameEn"
          class="concept-item neg"
        >
          <view class="concept-dot neg-dot"></view>
          <text class="concept-name">{{item.nameCn}}</text>
          <text class="concept-qual neg-qual">{{item.qualitative}}</text>
        </view>
      </view>
    </view>

    <!-- ⑤ 底部说明 + 助手入口 -->
    <view class="bottom-bar">
      <text class="bottom-tip">如对报告有疑问，可前往「助手」页面咨询</text>
      <view class="btn-assistant" bindtap="onGoAssistant">
        <text>前往智能助手 ›</text>
      </view>
    </view>

  </block>

  <!-- 报告不存在 -->
  <view wx:elif="{{!loading}}" class="state-center">
    <text class="state-icon">❓</text>
    <text class="state-text">报告不存在或无权查看</text>
  </view>

</view>

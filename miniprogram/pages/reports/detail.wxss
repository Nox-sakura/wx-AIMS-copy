/* pages/reports/detail.wxss */

.page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 60rpx;
}

/* Grade 核心展示区 */
.grade-section {
  background: var(--card);
  padding: 48rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
  position: relative;
}

.desensitized-tag {
  position: absolute;
  top: 24rpx;
  right: 32rpx;
  font-size: 20rpx;
  background: var(--border);
  color: var(--muted);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}

.grade-label {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text);
}

.grade-desc {
  font-size: 26rpx;
  color: var(--muted);
  text-align: center;
  line-height: 1.6;
  padding: 0 20rpx;
}

.meta-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  margin-top: 8rpx;
}

.meta-item {
  font-size: 24rpx;
  color: var(--muted);
}

/* 通用 section 卡片 */
.section-card {
  background: var(--card);
  margin: 0 0 16rpx;
  padding: 32rpx 40rpx;
}

.section-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 24rpx;
}

.section-icon {
  font-size: 32rpx;
}

/* 关键指标网格 */
.key-points-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.key-point-item {
  background: var(--bg);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.kp-label {
  font-size: 22rpx;
  color: var(--muted);
}

.kp-value {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
}

/* 概念指标 */
.concept-tip {
  font-size: 22rpx;
  color: var(--muted);
  background: #FFFBEB;
  border: 1rpx solid #FDE68A;
  border-radius: 8rpx;
  padding: 14rpx 20rpx;
  margin-bottom: 24rpx;
  line-height: 1.6;
}

.concept-group {
  margin-bottom: 24rpx;
}

.concept-group-label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--muted);
  display: block;
  margin-bottom: 12rpx;
}

.concept-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.concept-item:last-child {
  border-bottom: none;
}

.concept-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.pos-dot { background: #27AE60; }
.neg-dot { background: #E67E22; }

.concept-name {
  flex: 1;
  font-size: 26rpx;
  color: var(--text);
}

.concept-qual {
  font-size: 24rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
}

.pos-qual {
  background: #E8F8EF;
  color: #27AE60;
}

.neg-qual {
  background: #FEF0E7;
  color: #E67E22;
}

/* 医嘱与建议：背景与竖条改为警示黄，视觉上区分"操作指令"与"信息展示" */
.doctor-note {
  font-size: 26rpx;
  color: var(--text);
  line-height: 1.8;
  background: #FFFBEB;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  border-left: 6rpx solid var(--warning);
}

/* 底部说明栏 */
.bottom-bar {
  padding: 32rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.bottom-tip {
  font-size: 24rpx;
  color: var(--muted);
  text-align: center;
}

.btn-assistant {
  background: var(--primary-light);
  color: var(--primary);
  font-size: 26rpx;
  font-weight: 600;
  padding: 20rpx 48rpx;
  border-radius: 48rpx;
}

/* 空/加载状态 */
.state-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
  gap: 16rpx;
}

.state-icon { font-size: 80rpx; }
.state-text { font-size: 28rpx; color: var(--muted); }

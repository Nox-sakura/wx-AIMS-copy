<!-- pages/index/index.wxml -->
<view class="page">

  <!-- 顶部标题栏 -->
  <view class="page-header">
    <view class="header-left">
      <text class="header-title">消息中心</text>
      <text wx:if="{{unreadCount > 0}}" class="unread-badge">{{unreadCount}}</text>
    </view>
    <text class="header-action" bindtap="onMarkAllRead">全部已读</text>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="state-center">
    <text class="state-text">加载中…</text>
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{messages.length === 0}}" class="state-center">
    <text class="state-icon">📭</text>
    <text class="state-text">暂无消息</text>
  </view>

  <!-- 消息列表 -->
  <view wx:else class="msg-list">
    <message-card
      wx:for="{{messages}}"
      wx:key="id"
      item="{{item}}"
      bind:tap="onMessageTap"
    />
  </view>

</view>

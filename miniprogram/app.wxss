/* app.wxss — 全局样式变量与基础重置 */
/* 所有页面通过继承获取颜色变量，禁止在页面内硬编码颜色值 */

page {
  /* ── Grade 语义色（来自论文 Fig.8(c)，不可更改） ── */
  --grade1: #27AE60;   /* Grade 1 绿色：优秀，安全 */
  --grade2: #F1C40F;   /* Grade 2 黄色：良好，关注 */
  --grade3: #E67E22;   /* Grade 3 橙色：一般，谨慎 */
  --grade4: #E74C3C;   /* Grade 4 红色：较差，警示 */

  /* ── 主题色 ── */
  --primary: #1A6EBD;
  --primary-light: #D6EAF8;
  --primary-dark: #154E8A;

  /* ── 中性色 ── */
  --bg: #F5F7FA;
  --card: #FFFFFF;
  --text: #2C3E50;
  --muted: #7F8C8D;
  --border: #E8ECF0;

  /* ── 功能色 ── */
  --success: #27AE60;
  --warning: #F39C12;
  --danger: #E74C3C;

  /* ── 基础重置 ── */
  background-color: var(--bg);
  color: var(--text);
  font-family: -apple-system, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

/* 通用卡片 */
.card {
  background: var(--card);
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
}

/* 通用主操作按钮 */
.btn-primary {
  display: block;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: var(--primary);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 16rpx;
  border: none;
}

.btn-primary[disabled] {
  background: #B0C4D8;
  color: #fff;
}

/* 通用次级按钮 */
.btn-ghost {
  display: block;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: transparent;
  color: var(--primary);
  font-size: 32rpx;
  border-radius: 16rpx;
  border: 2rpx solid var(--primary);
}

/* 通用输入框 */
.input-field {
  width: 100%;
  height: 88rpx;
  padding: 0 28rpx;
  background: var(--bg);
  border: 2rpx solid var(--border);
  border-radius: 12rpx;
  font-size: 28rpx;
  color: var(--text);
  box-sizing: border-box;
}

.input-field:focus {
  border-color: var(--primary);
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: var(--border);
  margin: 24rpx 0;
}

/* 文字截断 */
.text-ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
